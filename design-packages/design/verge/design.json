        "default": { "url": "https://fonts.googleapis.com/css2?family=Gloock&display=swap", "family": "Gloock" }
      }
    },
    "word": {
      "fontChoice": null,
      "css": "font:400 1000px/1 {family};letter-spacing:-.03em",
      "fonts": {
        "default": { "url": "https://fonts.googleapis.com/css2?family=Gloock&display=swap", "family": "Gloock" }
      }
    },
    "brand": {
      "fontChoice": null,
      "css": "font:400 1000px/1 {family};letter-spacing:-.01em",
