      ["A:#2A5F38", "#F3F0E6", 4.5, "accent text on the page"],
      ["A:#2A5F38", "#E8E3D3", 4.5, "accent text on the tinted section"],
      ["A:#2A5F38", "A:#DDEAD9", 4.5, "accent text on the soft accent"]
