{
  "name": "aldane",
  "category": "watch launch",
  "reference": "reference/aldane-original.html",
  "referenceSha256": "7bb676f7a3878b7c69a45d571c9edc917b650b3f8aac94be3c25a89cbdc3610c",
  "template": "template.html",
  "schema": "schema.json",
  "hooks": "hooks.js",
  "families": {},
  "checks": {},
  "metrics": {
    "word": {
      "fontChoice": null,
      "css": "font:500 1000px/.82 {family};letter-spacing:.02em;text-transform:uppercase",
      "fonts": {
        "default": {
          "url": "https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500&display=swap",
          "family": "Bodoni Moda"
        }
      }
    }
  },
  "guards": [
    {
      "name": "footer word fit",
      "type": "fitText",
      "selector": ".wordmark",
      "text": [
        "brand.name"
      ],
      "metric": "word",
      "size": [
        72,
        21,
        300
      ],
      "container": {
        "max": 1240,
        "gutter": [
          16,
          4,
          null
        ]
      },
      "skipIf": {
        "path": "theme.wordmarkFit",
        "equals": "crop"
      },
      "suffix": ".",
      "fill": 0.9,
      "note": "Bodoni Moda draws about 4% wider in WebKit than the measured glyph table; fill 0.9 leaves room for the full stop"
    }
  ],
  "photoHero": {"hide":[".sheet","#construct",".scene","#clines","#tags"]}
}