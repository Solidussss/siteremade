  "care": {
    "eyebrow": "Aftercare",
    "title": "Heal it",
    "titleEm": "right.",
    "sub": "The first month decides how it looks for the next forty years. Here's what to do, day by day.",
    "steps": [
      {
        "when": "Day 1",
        "n": "Wrap off",
        "d": "Leave the film on for a few hours, then wash it gently with warm water and unscented soap. Pat dry."
      },
      {
        "when": "Days 2 to 4",
        "n": "Thin and often",
        "d": "A thin layer of balm two or three times a day. It should shine a little, not look greasy."
      },
      {
        "when": "Days 5 to 14",
        "n": "Peel and itch",
        "d": "It will flake and itch. Don't pick or scratch; tap it, and keep moisturising."
      },
      {
        "when": "Week 4",
        "n": "Healed",
        "d": "Settled and bright. Come back for a free touch-up and a photo if anything needs it."
      }
    ],
