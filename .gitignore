# V8.5: runtime-only persistence artifacts -- never committed.
# data/siteremade.db(-wal/-shm) is the real, file-backed node:sqlite
# database (see lib/db.js's getDb default path); data/asset-store/ is the
# content-addressed local image store (see lib/project-store.js). Both are
# generated by running server.js and are pure runtime state, analogous to
# a real Postgres/Supabase database + object storage bucket -- never source,
# never something a fresh clone of this repo should start with populated.
/data/

# Editor/OS noise, in case this ever gets cloned onto a machine that adds
# them (harmless here, but a normal thing for a repo's .gitignore to have).
.DS_Store
node_modules/
